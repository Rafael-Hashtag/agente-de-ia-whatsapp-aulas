# Modelo do .env. O jeito fácil é rodar:  python3 scripts/configurar.py
# (ele faz as perguntas, testa suas chaves e gera o .env sozinho)

# Docker: quais serviços sobem (evolution = WhatsApp por QR Code; https = Caddy com certificado)
COMPOSE_PROFILES=evolution
DOMINIO=
FUSO=America/Sao_Paulo

# Canal de WhatsApp: evolution | meta
CANAL=evolution

# IA que conversa com os leads: anthropic | openai | gemini
IA_PROVEDOR=anthropic
IA_MODELO=claude-opus-5-5
IA_ESFORCO=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Transcrição de áudio: openai | groq | nenhum
TRANSCRICAO_PROVEDOR=nenhum
GROQ_API_KEY=

# Evolution GO (o configurador gera valores aleatórios)
EVOLUTION_API_KEY_GLOBAL=
EVOLUTION_INSTANCIA=agente-vendas
EVOLUTION_TOKEN_INSTANCIA=
WEBHOOK_SEGREDO=
POSTGRES_SENHA=
EVOLUTION_EMAIL_LICENCA=

# API oficial da Meta (só se CANAL=meta)
META_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Venda
LINK_CHECKOUT=
DONO_TELEFONE=
MODO_ATENDIMENTO=todos
FRASE_GATILHO=
NUMEROS_IGNORADOS=

# Follow-up automático
FOLLOWUP_ATIVO=true
FOLLOWUP_HORAS=20
FOLLOWUP_MAX=2
HORARIO_INICIO=9
HORARIO_FIM=20

# Planilha de leads
SHEETS_WEBHOOK_URL=
PAINEL_TOKEN=

# Ajustes finos (opcionais)
# DEBOUNCE_SEGUNDOS=8          espera por mensagens picadas antes de responder
# PAUSA_HUMANO_HORAS=12        quanto tempo o robô fica quieto depois que você responde pelo celular
# HISTORICO_MAX_MENSAGENS=40   quantas mensagens da conversa a IA relê
# ATRASO_MAXIMO_MINUTOS=30     mensagens mais antigas que isso são ignoradas (ex.: após o servidor cair)
